# All dates must include a UTC offset. All prices are USD; probabilities are 0..1.
DATABASE_URL=sqlite:///data/gold_model.db
PYTH_API_KEY=
PYTH_BASE_URL=https://pyth.dourolabs.app/hermes
# Exact source feed; leave blank to discover the unambiguous XAU/USD feed.
PYTH_FEED_ID=
KALSHI_API_KEY=
KALSHI_PRIVATE_KEY_PATH=
KALSHI_BASE_URL=https://external-api.kalshi.com/trade-api/v2
KALSHI_SERIES_TICKER=KXGOLD15M
# Set true only after checking current series rules, equality/rounding, and Pyth feed identity.
MARKET_REFERENCE_VERIFIED=false
COMEX_PROVIDER=databento
COMEX_API_KEY=
# Select an actual listed GC contract. Update deliberately at roll; no automatic back-adjustment.
COMEX_CONTRACT=
COMEX_DATASET=GLBX.MDP3
COMEX_CSV_PATH=
COMEX_DELAY_SECONDS=600
POLL_SECONDS=5
SPOT_MAX_AGE_SECONDS=15
BOOK_MAX_AGE_SECONDS=15
COMEX_MAX_AGE_SECONDS=30
MIN_EDGE=0.05
INCLUDE_FEES=true
# Conservative flat fee assumption, NOT a claim about the current exchange fee schedule.
FEE_PER_CONTRACT=0.02
# Optional quadratic rate overrides the flat fee, rounded up to cents per order.
QUADRATIC_FEE_RATE=
SLIPPAGE_CENTS=0
SIZING_METHOD=fractional_kelly
KELLY_FRACTION=0.25
MAX_POSITION_DOLLARS=100
MAX_FRACTION_OF_BANKROLL_PER_MARKET=0.02
FIXED_CONTRACTS=1
FIXED_DOLLAR_RISK=10
BANKROLL=1000
DATASET_PATH=artifacts/dataset.csv
MODEL_PATH=artifacts/logistic.joblib
REPORT_DIR=artifacts/reports
SNAPSHOT_SECONDS=60
# Leave blank for strict receipt-time availability. Historical backfills then cannot
# masquerade as observations recorded live. Set only for explicitly assumed-latency research.
HISTORICAL_LATENCY_SECONDS=
LOG_LEVEL=INFO
